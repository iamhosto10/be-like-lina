# --- Sanity (blog) ---------------------------------------------------------
# Opcionales: el sitio ya trae el Project ID y el dataset por defecto (src/lib/sanityConfig.ts).
# Defínelos solo para apuntar a otro proyecto o dataset (p. ej. uno de pruebas).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Token con rol Viewer (sanity.io/manage → proyecto → API → Tokens). Solo servidor.
# Solo hace falta si el dataset es privado.
SANITY_API_READ_TOKEN=
# Mismo string que el "Secret" del webhook de Sanity → /api/revalidate.
SANITY_REVALIDATE_SECRET=

# --- Sitio ------------------------------------------------------------------
# Opcional: fuerza la URL base (canonical, Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL=

# --- Tienda: carrito y pagos con Mercado Pago ------------------------------------------------
# Sin MERCADOPAGO_ACCESS_TOKEN ni CHECKOUT_DEMO_MODE la tienda queda apagada: no hay carrito y las
# fichas siguen con «Comprar por WhatsApp». Detalle y pasos en el README (sección «Tienda y pagos»).

# Credenciales de Mercado Pago → mercadopago.com.co/developers → Tus integraciones → tu aplicación.
# «Credenciales de prueba» para probar sin cobrar y «Credenciales de producción» para cobrar.
MERCADOPAGO_ACCESS_TOKEN=
# Clave secreta del webhook (Tus integraciones → Webhooks → «Clave secreta»). Obligatoria con el token.
MERCADOPAGO_WEBHOOK_SECRET=
# Solo si tu cuenta de prueba exige la URL «sandbox» (true/false).
MERCADOPAGO_USE_SANDBOX_URL=
# (La «Public Key» no se usa: el pago ocurre en la página de Mercado Pago, Checkout Pro.)

# Modo demostración: el pago se simula dentro del sitio (sin Mercado Pago ni cobro). Solo aplica
# cuando NO hay MERCADOPAGO_ACCESS_TOKEN. Útil para enseñarle el flujo a Lina antes de tener credenciales.
CHECKOUT_DEMO_MODE=

# Correos (Resend → resend.com → API Keys). Sin clave, los correos se escriben en el log del servidor.
RESEND_API_KEY=
# Remitente: debe ser de un dominio verificado en Resend, p. ej. «Be Like Lina <pedidos@belikelina.com>».
ORDER_EMAIL_FROM=
# Quién recibe el aviso de cada pedido pagado (varios, separados por coma). Por defecto, ventas@belikelina.com.
ORDER_NOTIFY_EMAIL=

# Pedidos (Upstash Redis): en Vercel → Storage → Marketplace → Upstash Redis → Connect Project.
# Vercel crea estas variables solas (o KV_REST_API_URL / KV_REST_API_TOKEN, que también se aceptan).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
