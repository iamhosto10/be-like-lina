# --- Sanity (blog) ---------------------------------------------------------
# Opcionales: el sitio ya trae el Project ID y el dataset por defecto (src/lib/sanityConfig.ts).
# Defínelos solo para apuntar a otro proyecto o dataset (p. ej. uno de pruebas).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Token con rol Viewer (sanity.io/manage → proyecto → API → Tokens). Solo servidor.
# Solo hace falta si el dataset es privado.
SANITY_API_READ_TOKEN=
# Mismo string que el "Secret" del webhook de Sanity → /api/revalidate.
SANITY_REVALIDATE_SECRET=

# --- Sitio ------------------------------------------------------------------
# Opcional: fuerza la URL base (canonical, Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL=

# --- Tienda: carrito y pagos con ePayco -------------------------------------------------------
# Sin las tres credenciales de ePayco ni CHECKOUT_DEMO_MODE la tienda queda apagada: no hay carrito y
# las fichas siguen con «Comprar por WhatsApp». Detalle y pasos en el README (sección «Tienda y pagos»).

# ePayco → dashboard.epayco.co → Integraciones → Llaves API (Configuración → Datos de la cuenta).
# Llave pública (P_PUBLIC_KEY): la usa el botón de pago en el navegador.
EPAYCO_PUBLIC_KEY=
# P_CUST_ID_CLIENTE: id de cliente. Secreto (solo servidor).
EPAYCO_CUSTOMER_ID=
# P_KEY: llave privada. Secreta (solo servidor).
EPAYCO_P_KEY=
# true (o vacío) = pagos de PRUEBA, no se cobra. Pasa a false SOLO cuando quieras cobrar de verdad.
EPAYCO_TEST=true

# Modo demostración: el pago se simula dentro del sitio (sin ePayco ni cobro). Solo aplica
# cuando NO hay credenciales de ePayco. Útil para enseñarle el flujo a Lina antes de tener credenciales.
CHECKOUT_DEMO_MODE=

# Correos (Resend → resend.com → API Keys). Sin clave, los correos se escriben en el log del servidor.
RESEND_API_KEY=
# Remitente: debe ser de un dominio verificado en Resend, p. ej. «Be Like Lina <pedidos@belikelina.com>».
ORDER_EMAIL_FROM=
# Quién recibe el aviso de cada pedido pagado (varios, separados por coma). Por defecto, ventas@belikelina.com.
ORDER_NOTIFY_EMAIL=

# Pedidos (Upstash Redis): en Vercel → Storage → Marketplace → Upstash Redis → Connect Project.
# Vercel crea estas variables solas (o KV_REST_API_URL / KV_REST_API_TOKEN, que también se aceptan).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
