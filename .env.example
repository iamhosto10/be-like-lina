# --- Sanity (blog) ---------------------------------------------------------
# Sin NEXT_PUBLIC_SANITY_PROJECT_ID el sitio usa el contenido local de src/data.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Token con rol Viewer (sanity.io/manage → proyecto → API → Tokens). Solo servidor.
# Solo hace falta si el dataset es privado.
SANITY_API_READ_TOKEN=
# Mismo string que el "Secret" del webhook de Sanity → /api/revalidate.
SANITY_REVALIDATE_SECRET=

# --- Sitio ------------------------------------------------------------------
# Opcional: fuerza la URL base (canonical, Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL=
